# =========================================================
# Early Boot Logger
# Created by: RofikKernelDev
# Target: Android 16 GSI Debugging
# Logs saved to /metadata/rofik_logs
# =========================================================

on early-init
    mkdir /metadata/rofik_logs 0777 root root
    chmod 0777 /metadata/rofik_logs
    exec_background u:r:init:s0 root root log system -- /system/bin/sh /vendor/bin/rofik_early.sh

on property:sys.boot_completed=1
    exec_background root root -- /system/bin/sh -c "logcat -b all -d > /metadata/rofik_logs/logcat_boot_complete.txt"
